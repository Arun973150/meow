# Python
__pycache__/
*.py[cod]
.venv/
venv/
env/
*.egg-info/

# Spike output
*.json.out
probe_*.json

# Secrets - never commit keys. See docs/03-safety.md
.env
.env.*
# The template carries no secrets and is how anyone else learns what to set.
!.env.example
*.key
*.pem

# Editor / OS
.vscode/
.idea/
Thumbs.db
desktop.ini
reference/
models/

# Wheel-build leftovers. `pip wheel` is used to CHECK that
# package-data entries really ship - the recipes vanished once
# because one did not - and it leaves these behind.
build/
dist/
*.whl

# Belt and braces: uiautomation's own log, now pointed at
# %LOCALAPPDATA%/Meow/uia.log in meow/desktop/uia.py. Any copy
# here was written before that, or by a script run from the root.
@AutomationLog.txt
